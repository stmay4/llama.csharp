  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\llama.csharp\Llama.csharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\mtmdAudioTest%28gen%29.wav">
